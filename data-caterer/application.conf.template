# Shared defaults for every system's seed job. data-caterer/script/seed.sh
# renders this into application.conf (gitignored) each run, substituting
# @@SYS@@ -- required because PLAN_FILE_PATH (also set, in docker-compose)
# does NOT override folders.planFilePath below on its own (confirmed
# directly: with two plan files present, Data Caterer always loaded the
# file named here, ignoring PLAN_FILE_PATH, and crashed writing into the
# other system's unmounted output dir).
#
# Every top-level block here must be present even for a plain CSV run --
# mirrors Data Caterer's own example application.conf, trimmed of unused
# Kafka/Cassandra/etc. connection blocks. Each plan's own `config:` block
# overrides flags/generation/folders for that specific run.
flags {
    enableCount = true
    enableGenerateData = true
    enableGeneratePlanAndTasks = false
    enableRecordTracking = false
    enableDeleteGeneratedRecords = false
    enableFailOnError = true
    enableUniqueCheck = true
    enableSinkMetadata = false
    enableSaveReports = false
    enableValidation = false
    enableGenerateValidations = false
    enableAlerts = false
}

folders {
    generatedPlanAndTaskFolderPath = "/opt/app/custom/generated"
    planFilePath = "/opt/app/custom/plan/.rendered/@@SYS@@.yaml"
    taskFolderPath = "/opt/app/custom/task"
    validationFolderPath = "/opt/app/custom/validation"
    recordTrackingFolderPath = "/opt/app/custom/recordTracking"
    recordTrackingForValidationFolderPath = "/opt/app/custom/validation/recordTracking"
    generatedReportsFolderPath = "/opt/app/data/@@SYS@@/report"
}

metadata {
    numRecordsFromDataSource = 10000
    numRecordsForAnalysis = 10000
    oneOfDistinctCountVsCountThreshold = 0.1
    oneOfMinCount = 1000
    numGeneratedSamples = 10
}

generation {
    numRecordsPerBatch = 100000
}

validation {
    numSampleErrorRecords = 5
    enableDeleteRecordTrackingFiles = true
}

alert {
    triggerOn = "all"
    slackAlertConfig {
        token = ""
        channels = []
    }
}

runtime {
    master = "local[*]"
    config {
        "spark.driver.memory" = "2g"
        "spark.executor.memory" = "2g"
        "spark.sql.shuffle.partitions" = "4"
    }
}

csv {
    csv {
    }
}

# No jdbc {} block here -- see application-jdbc.conf.template, appended
# separately by data-caterer/script/seed.sh only for FORMAT=sql. A jdbc {}
# block's mere presence, keyed by a name matching a dataSources entry,
# makes Data Caterer validate that dataSource as jdbc-shaped regardless of
# its actual connection.type (confirmed directly) -- it must be textually
# absent for a plain FORMAT=csv run, not just unused.
