# Appended to application.conf by data-caterer/script/seed.sh only for
# FORMAT=sql -- see application.conf.template's comment for why it can't
# be unconditional. A plan's connection.url/user/password/driver are NOT
# honored if inlined in the YAML (confirmed directly); Data Caterer only
# picks them up from a block here keyed by the same name as the plan's
# dataSources.name, which by convention equals @@SYS@@.
jdbc {
    "@@SYS@@" {
        url = "jdbc:postgresql://postgres:5432/@@SYS@@"
        user = "postgres"
        password = "postgres"
        driver = "org.postgresql.Driver"
    }
}
